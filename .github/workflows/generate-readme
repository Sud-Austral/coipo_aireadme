name: Generate README

on:
  workflow_call:

jobs:
  generate-readme:
    name: Generate and update README
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:

      # --------------------------------------------------
      # 1. Descargar el repositorio que llama
      # --------------------------------------------------

      - name: Checkout target repository
        uses: actions/checkout@v4
        with:
          path: target
          fetch-depth: 0

      # --------------------------------------------------
      # 2. Descargar el repositorio maestro
      # --------------------------------------------------

      - name: Checkout AI README
        uses: actions/checkout@v4
        with:
          repository: Sud-Austral/coipo_aireadme
          path: ai-readme

      # --------------------------------------------------
      # 3. Configurar Python
      # --------------------------------------------------

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      # --------------------------------------------------
      # 4. Instalar dependencias
      # --------------------------------------------------

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests

      # --------------------------------------------------
      # 5. Verificar repositorios
      # --------------------------------------------------

      - name: Verify repositories
        run: |
          echo "======================================"
          echo "TARGET REPOSITORY"
          echo "======================================"
          ls -la target

          echo ""
          echo "======================================"
          echo "AI README REPOSITORY"
          echo "======================================"
          ls -la ai-readme

      # --------------------------------------------------
      # 6. Verificar archivos del sistema AI README
      # --------------------------------------------------

      - name: Verify AI README files
        run: |
          echo "======================================"
          echo "PYTHON FILES"
          echo "======================================"

          ls -la ai-readme/*.py

          echo ""
          echo "======================================"
          echo "API CONFIGURATION"
          echo "======================================"

          if [ ! -f "ai-readme/api.json" ]; then
            echo "ERROR: No existe ai-readme/api.json"
            exit 1
          fi

          echo "api.json encontrado."

      # --------------------------------------------------
      # 7. Verificar Python
      # --------------------------------------------------

      - name: Verify Python
        run: |
          python --version

      # --------------------------------------------------
      # 8. Verificar sintaxis de los scripts
      # --------------------------------------------------

      - name: Verify scripts
        run: |
          python -m py_compile ai-readme/readme3.py
          python -m py_compile ai-readme/makeReadme.py

          echo "Scripts Python válidos."

      # --------------------------------------------------
      # 9. Generar README
      # --------------------------------------------------

      - name: Generate README
        run: |
          echo "======================================"
          echo "GENERANDO README"
          echo "======================================"

          python ai-readme/makeReadme.py target

      # --------------------------------------------------
      # 10. Verificar README generado
      # --------------------------------------------------

      - name: Verify generated README
        run: |
          echo "======================================"
          echo "VERIFICANDO README"
          echo "======================================"

          if [ ! -f "target/README.md" ]; then
            echo "ERROR: makeReadme.py no generó README.md"
            exit 1
          fi

          echo "README.md generado correctamente."

          echo ""
          echo "Tamaño:"
          wc -c target/README.md

          echo ""
          echo "Primeras 80 líneas:"
          head -80 target/README.md

      # --------------------------------------------------
      # 11. Verificar contexto generado
      # --------------------------------------------------

      - name: Verify README context
        run: |
          echo "======================================"
          echo "README CONTEXT"
          echo "======================================"

          if [ -d "target/readme_context" ]; then
            find target/readme_context -maxdepth 2 -type f -print
          else
            echo "ADVERTENCIA: no existe readme_context/"
          fi

      # --------------------------------------------------
      # 12. Mostrar estado Git
      # --------------------------------------------------

      - name: Show Git status
        run: |
          cd target

          echo "======================================"
          echo "GIT STATUS"
          echo "======================================"

          git status --short

      # --------------------------------------------------
      # 13. Mostrar cambios del README
      # --------------------------------------------------

      - name: Show README diff
        run: |
          cd target

          echo "======================================"
          echo "README DIFF"
          echo "======================================"

          git diff -- README.md

      # --------------------------------------------------
      # 14. Commit y push
      # --------------------------------------------------

      - name: Commit and push README
        run: |
          cd target

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          if git diff --quiet -- README.md; then
            echo "README.md no tiene cambios."
            exit 0
          fi

          git add README.md

          git commit -m "docs: update README automatically"

          git push

          echo ""
          echo "======================================"
          echo "README ACTUALIZADO CORRECTAMENTE"
          echo "======================================"